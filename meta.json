{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:obstacles-pointcloud",
  "visibility": "public",
  "url": "https://github.com/viam-modules/obstacles-pointcloud",
  "description": "Vision services that find well-separated objects above a flat plane, from a camera's point cloud or depth image",
  "models": [
    {
      "api": "rdk:service:vision",
      "model": "viam:obstacles-pointcloud:obstacles-pointcloud",
      "short_description": "Service to identify well-separated objects above a flat plane",
      "markdown_link": "README.md#model-viamobstacles-pointcloudobstacles-pointcloud"
    },
    {
      "api": "rdk:service:vision",
      "model": "viam:obstacles-depth:obstacles-depth",
      "short_description": "Service to identify well-separated objects above a flat plane from a depth image",
      "markdown_link": "README.md#model-viamobstacles-depthobstacles-depth"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/obstacles-pointcloud",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64",
      "windows/amd64"
    ],
    "darwin_deps": ["go", "nlopt-static"]
  }
}
